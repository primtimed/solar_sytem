  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: 'Neptunus was de eerste planeet die met behulp van wiskundige berekeningen
    werd ontdekt.


    Neptunus is de achtste planeet vanaf de zon en staat op een
    afstand van 4,5 miljard kilometer.


    Hij staat zo ver af van de zon dat het
    wel 165 jaar duurt voordat Neptunus een rondje om de zon heeft gedraaid.'
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 125cb55b44b24c4393181402bc6200e6, type: 2}
  m_sharedMaterial: {fileID: 2100000, guid: 125cb55b44b24c4393181402bc6200e6, type: 2}
