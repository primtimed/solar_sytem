      m_Calls: []
  m_text: "Mercurius kent enorme temperatuur-verschillen tussen dag en nacht. Overdag
    loopt de temperatuur op tot zo\u2019n 426\xB0 Celsius en \u2018s nachts tot -173\xB0
    Celsius."
  m_isRightToLeft: 0
