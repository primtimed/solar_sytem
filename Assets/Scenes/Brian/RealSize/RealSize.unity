  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: 'Jupiter is een gasplaneet, met een temperatuur van 153 graden Celsius
    onder de 0.


    Jupiter is vernoemd naar de Romeinse oppergod, en Jupiter wordt
    dan ook wel de koning van alle planeten genoemd. Jupiter bestaat uit ongeveer
    90% waterstof en 10% helium.'
  m_isRightToLeft: 0
