  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "De zon is een 4.7 biljoenen jaren oud gasbol.\n\nOngeveer 60% van het
    gas van de zon zit in de kern samengeperst bij een temperatuur van 15 miljoen
    \xB0C.\n\nDe zon is ontstaan uit het samenkrimpen van een grote interstellaire
    gaswolk onder invloed van eigen zwaartekracht."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 125cb55b44b24c4393181402bc6200e6, type: 2}
