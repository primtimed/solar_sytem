  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: 'De Aarde is de derde planeet die staat op 150 miljoen kilometer vanaf
    de zon. De aarde is het enige bekende planeet die leven kan ondersteunen, met
    miljoenen soorten.


    De kern is van metaal, de buitenkern is gloeiend heet
    en vloeibaar. Daarbovenop hardere lagen met drijvende continenten waarop het
    leven zich afspeelt.'
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 125cb55b44b24c4393181402bc6200e6, type: 2}
  m_sharedMaterial: {fileID: 2100000, guid: 125cb55b44b24c4393181402bc6200e6, type: 2}
