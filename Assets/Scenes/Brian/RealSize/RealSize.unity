      m_Calls: []
  m_text: 'De maan is het enige hemellichaam dat een baan om de aarde beschrijft.
    De maan is veel kleiner dan de aarde, en heeft daardoor een zwakker zwaartekracht.


    Op
    de maan weegt alles zes keer zo weinig als op aarde.'
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 125cb55b44b24c4393181402bc6200e6, type: 2}
  m_sharedMaterial: {fileID: 2100000, guid: 125cb55b44b24c4393181402bc6200e6, type: 2}
