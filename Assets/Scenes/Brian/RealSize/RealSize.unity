  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: 'Mercurius is de binnenste planeet van ons zonnestelsel.


    Net als
    de maan heeft Mercurius geen atmosfeer, maar alleen een dunne exosfeer. Deze
    bestaat voornamelijk uit zuurstof, natrium, waterstof, helium en kalium.


    Het
    gebrek aan een atmosfeer en de extreme temperatuurverschillen zorgen ervoor dat
    Mercurius zich waarschijnlijk niet leent voor leven.'
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 125cb55b44b24c4393181402bc6200e6, type: 2}
  m_sharedMaterial: {fileID: 2100000, guid: 125cb55b44b24c4393181402bc6200e6, type: 2}
